---
import Base from '../../layouts/Base.astro';
import BlogList from '../../components/BlogList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => data.lang === 'en')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Blog — Mehdi Amrane"
  description="Notes on front-end development, tools, and building things."
  lang="en"
  image="/og/blog.png"
  hrefFr="/fr/blog"
>
  <BlogList lang="en" posts={posts} heading="Blog" postHref={(slug) => `/blog/${slug}`} />
</Base>
