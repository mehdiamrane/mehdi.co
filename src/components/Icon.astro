---
// Phosphor Icon — inline SVG sourced directly from @phosphor-icons/core
// Usage: <Icon name="envelope" size={16} class="opacity-50" />

import envelope from '@phosphor-icons/core/assets/regular/envelope.svg?raw';
import linkedinLogo from '@phosphor-icons/core/assets/regular/linkedin-logo.svg?raw';
import githubLogo from '@phosphor-icons/core/assets/regular/github-logo.svg?raw';
import xLogo from '@phosphor-icons/core/assets/regular/x-logo.svg?raw';
import fileText from '@phosphor-icons/core/assets/regular/file-text.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';

const icons: Record<string, string> = {
  'envelope': envelope,
  'linkedin-logo': linkedinLogo,
  'github-logo': githubLogo,
  'x-logo': xLogo,
  'file-text': fileText,
  'arrow-up-right': arrowUpRight,
};

export interface Props {
  name: string;
  size?: number;
}

const { name, size = 16, ...attrs } = Astro.props;

const svg = icons[name];
const innerHTML = svg?.match(/<svg[^>]*>([\s\S]*)<\/svg>/)?.[1];
---

{
  innerHTML && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      fill="currentColor"
      viewBox="0 0 256 256"
      aria-hidden="true"
      {...attrs}
      set:html={innerHTML}
    />
  )
}
