---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import content, { techIcons, techStack, type Lang } from '../data/content';

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
---

<Base title={t.meta.title} description={t.meta.description} lang={lang} image="/og/home.png">
  <!-- Hero -->
  <header class="mb-24 reveal">
    <div class="flex items-start gap-5 mb-8">
      <img
        src="/avatar.png"
        alt={t.hero.name}
        class="w-20 h-20 rounded-full ring-2 ring-[var(--color-border)] flex-shrink-0 object-cover"
        width="80" height="80"
      />
      <div>
        <h1 class="text-3xl font-semibold tracking-tight mb-2">{t.hero.name}</h1>
        <p class="text-[var(--color-muted)] leading-relaxed max-w-md">
          {t.hero.description}
        </p>
      </div>
    </div>

    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-sm">
      {t.links.map(link => (
        <a
          href={link.href}
          class="link-underline inline-flex items-center gap-2 text-[var(--color-muted)]"
          {...(link.external !== false ? { target: '_blank', rel: 'noopener' } : {})}
        >
          <Icon name={link.icon} size={16} />
          {link.label}
        </a>
      ))}
    </nav>
  </header>

  <!-- Work Experience -->
  <section class="mb-24">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)] mb-10 reveal">{t.experienceTitle}</h2>
    <div class="space-y-8">
      {t.experience.map((job, i) => (
        <article
          class="reveal group rounded-2xl border border-[var(--color-border)] bg-[var(--color-card)] overflow-hidden transition-shadow duration-300 hover:shadow-[0_12px_32px_rgba(0,0,0,0.06)]"
          style={`animation-delay: ${(i + 1) * 80}ms`}
        >
          {job.image && (
            <a
              href={job.url ?? undefined}
              target={job.url ? '_blank' : undefined}
              rel={job.url ? 'noopener' : undefined}
              class={`block overflow-hidden ${job.url ? '' : 'pointer-events-none'}`}
              tabindex={job.url ? 0 : -1}
            >
              <img
                src={job.image}
                alt={job.imageAlt}
                loading="lazy"
                class="w-full h-40 sm:h-48 object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
            </a>
          )}

          <div class="p-6 sm:p-7">
            <div class="flex items-baseline justify-between gap-4 mb-2">
              <h3 class="font-semibold">
                {job.role}
              </h3>
              <span class="text-sm text-[var(--color-muted)] whitespace-nowrap tabular-nums">{job.period}</span>
            </div>
            <p class="text-sm text-[var(--color-muted)] mb-3">
              {job.url ? (
                <a href={job.url} class="link-underline inline-flex items-center gap-1 font-medium text-[var(--color-text)]" target="_blank" rel="noopener">
                  {job.company}
                  <Icon name="arrow-up-right" size={11} class="-mt-px" />
                </a>
              ) : <span class="font-medium text-[var(--color-text)]">{job.company}</span>}
              <span class="mx-2">·</span>
              {job.location}
            </p>
            <ul class="list-disc list-outside ml-4 space-y-1.5 text-sm leading-relaxed text-[var(--color-muted)] mb-4">
              {job.highlights.map(h => <li>{h}</li>)}
            </ul>
            <div class="flex flex-wrap gap-1.5">
              {job.techs.map(tech => (
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs rounded-full border border-[var(--color-border)] text-[var(--color-muted)]">
                  {techIcons[tech] && <img src={techIcons[tech]} alt="" width="12" height="12" class="w-3 h-3 object-contain" />}
                  {tech}
                </span>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Tech Stack -->
  <section class="mb-24">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)] mb-6 reveal">{t.techStackTitle}</h2>
    <div class="flex flex-wrap gap-2 reveal">
      {techStack.map(tech => (
        <span class="inline-flex items-center gap-2 px-3 py-1.5 text-sm border border-[var(--color-border)] rounded-full text-[var(--color-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-accent)] transition-colors duration-200 cursor-default">
          {techIcons[tech] && <img src={techIcons[tech]} alt="" width="16" height="16" class="w-4 h-4 object-contain" />}
          {tech}
        </span>
      ))}
    </div>
  </section>

  <!-- Contact -->
  <section class="mb-24 reveal">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-[var(--color-muted)] mb-6">{t.contact.title}</h2>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
      <span class="inline-flex items-center gap-2 text-[var(--color-muted)]">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
        </span>
        {t.contact.status}
      </span>
      <span class="text-[var(--color-muted)]">{t.contact.location}</span>
    </div>
    <div class="flex flex-wrap gap-3 mt-6">
      {t.contact.links.map(link => (
        <a href={link.href} class="inline-flex items-center gap-2 px-4 py-2 text-sm border border-[var(--color-border)] rounded-full text-[var(--color-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)] transition-colors duration-200" target="_blank" rel="noopener">
          <Icon name={link.icon} size={14} />
          {link.label}
        </a>
      ))}
    </div>
  </section>

  <!-- Footer -->
  <footer class="text-sm text-[var(--color-muted)] border-t border-[var(--color-border)] pt-8 reveal">
    <p>&copy; {new Date().getFullYear()} {t.hero.name}</p>
  </footer>
</Base>

<style is:global>
  .reveal {
    opacity: 0;
    transform: translateY(12px);
    animation: reveal 0.5s ease-out forwards;
  }

  @keyframes reveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .link-underline {
    color: inherit;
    text-decoration: none;
    box-shadow: inset 0 -0.125em 0 var(--color-accent);
    transition: all 150ms cubic-bezier(0.42, 0.14, 0.28, 0.93);
  }

  .link-underline:hover,
  .link-underline:focus-visible {
    box-shadow: inset 0 -1.35em 0 0 var(--color-accent);
    color: #fff;
  }
</style>
